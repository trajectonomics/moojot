{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  // moojot.trajectonomics.com: the landing page. See site/README.md.
  "name": "moojot-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "moojot.trajectonomics.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every other path is a static file and never wakes the script.
    "run_worker_first": ["/download", "/download/", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
